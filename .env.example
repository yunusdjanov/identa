# Frontend environment template
# Copy to `.env.local` (dev) or set via host (prod) before running.
# Anything prefixed `NEXT_PUBLIC_` is shipped to the browser bundle — do not
# put secrets here.

# ─────────────────────────────────────────────────────────────────────────
# Required
# ─────────────────────────────────────────────────────────────────────────

# Backend API base URL the browser will hit. Must include the `/api` suffix.
# In dev, point at the Next.js mock routes (http://localhost:3000/api) or
# directly at a running Laravel backend.
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Server-side API URL for SSR / proxy. Usually identical to the public URL
# but may bypass a CDN / use a private network address.
API_URL=http://localhost:3000/api

# Canonical public URL of the deployed site. Used by sitemap.ts, robots.ts,
# `metadataBase`, and Open Graph tags. Must include scheme, no trailing slash.
NEXT_PUBLIC_APP_URL=https://identa.uz

# ─────────────────────────────────────────────────────────────────────────
# Optional
# ─────────────────────────────────────────────────────────────────────────

# Google OAuth client ID (frontend half of the One-Tap login flow). Empty
# disables the Google sign-in button on /login and /register.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Turn on Vercel Analytics + Speed Insights. Must be the literal string
# `true` to enable; anything else (including absent) keeps them off.
NEXT_PUBLIC_ENABLE_VERCEL_ANALYTICS=false

# The in-app mock backend (`/api/v1/*`) is served automatically outside
# production. In a production build it is hard-blocked (404) because the mock
# login accepts any password. Only set this to the literal `true` if you are
# intentionally running a non-Laravel preview against the mocks — NEVER in a
# real production deploy.
NEXT_PUBLIC_ENABLE_MOCK_API=false
# Canonical live hosts (`identa.uz` and `www.identa.uz`) still hard-block
# `/api/v1/*` mock routes even if this flag is accidentally enabled.

# Sentry browser SDK. Empty DSN keeps Sentry inert — set both DSN +
# environment to ship error events. `SEND_PII=true` must be explicit
# (the default is to scrub the same key list the backend SentryEventSanitizer
# uses). `TRACES_SAMPLE_RATE` ≤ 0.1 keeps cost predictable.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_RELEASE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_SEND_PII=false
# Server/Edge Sentry runtime (instrumentation.ts) — usually identical
# to the public DSN. Set independently if you want different sampling.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=
SENTRY_TRACES_SAMPLE_RATE=0

# ─────────────────────────────────────────────────────────────────────────
# E2E / scripts (not used by the app at runtime)
# ─────────────────────────────────────────────────────────────────────────
# E2E_FRONTEND_URL=http://localhost:3100
# E2E_BACKEND_URL=http://localhost:8100
# E2E_DENTIST_EMAIL=dentist@identa.test
# E2E_DENTIST_PASSWORD=password123
# E2E_ADMIN_EMAIL=admin@identa.test
# E2E_ADMIN_PASSWORD=password123
