# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but DO track the secret-free templates so required vars are documented
!.env.example
!backend/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local editor
.vscode/
.idea/

# local runtime / temp files
.tools/
.superpowers/
/.next-dev-logs/
*.out.log
*.err.log
tmp-*.js
composer.phar
public/identa-handoff/landing.bundle.js

# test artifacts
/test-results/
/playwright-report/

# local backups
/backups/
/.codex-tmp/

# backend local runtime data
backend/database/*.sqlite
# stray sqlite db accidentally created when DB_DATABASE has no extension
backend/identa
backend/storage/logs/
backend/storage/framework/cache/
backend/storage/framework/sessions/
backend/storage/framework/views/
