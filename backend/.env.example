# Identa backend environment template
# Copy to `.env`, populate the required block, and run `php artisan key:generate`.
# Defaults shown here are the dev-mode defaults from config/*.php — change
# every entry marked REQUIRED before deploying to production.

# ──────────────────────────────────────────────────────────────────────
# Application — REQUIRED
# ──────────────────────────────────────────────────────────────────────
APP_NAME=Identa
APP_ENV=production
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.identa.uz
# Asia/Tashkent is enforced by the production secrets validator; do not
# leave blank or set to UTC for the live deploy — appointment timezones
# and audit timestamps depend on this.
APP_TIMEZONE=Asia/Tashkent
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ──────────────────────────────────────────────────────────────────────
# Frontend URL list (CORS + Sanctum + password reset link)
# Comma-separated origins. The first entry is used in password reset URLs;
# all entries are accepted by CORS and trusted by Sanctum's stateful API.
# ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://identa.uz
SECURITY_REQUIRE_HTTPS_FRONTEND_URL=true
AUTH_EMAIL_VERIFICATION_LINK_MINUTES=60
# Only abandoned registrations with no patient, staff, finance, or billing
# data are soft-deleted after this period.
AUTH_UNVERIFIED_ACCOUNT_RETENTION_DAYS=30

# Sanctum stateful API allow-list (host:port only, no scheme). Must include
# every frontend domain that will use cookie-based auth.
SANCTUM_STATEFUL_DOMAINS=identa.uz,www.identa.uz

# ──────────────────────────────────────────────────────────────────────
# Database — REQUIRED
# ──────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=identa
DB_USERNAME=identa
DB_PASSWORD=

# ──────────────────────────────────────────────────────────────────────
# Cache / Queue / Session
# ──────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=420
REDIS_QUEUE_BLOCK_FOR=5
QUEUE_WORKER_TIMEOUT=330
QUEUE_WORKER_MEMORY=384
QUEUE_NAMES=media,cleanup,default
SESSION_DRIVER=database
SESSION_LIFETIME=120
# Required for cross-subdomain cookies (api.identa.uz ↔ identa.uz).
SESSION_DOMAIN=.identa.uz
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# ──────────────────────────────────────────────────────────────────────
# Object storage (S3-compatible) — REQUIRED for production media
# ──────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1
AWS_BUCKET=identa-media
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false
# Re-verify the real stored object size on finalize instead of trusting the
# client-declared file_size. Costs one extra HEAD per saved image but stops a
# client from under-reporting size to skirt plan storage limits. Recommended
# `true` in production if the HEAD latency is acceptable.
MEDIA_VERIFY_DIRECT_UPLOADS_ON_FINALIZE=true

# ──────────────────────────────────────────────────────────────────────
# Antivirus (patient photo + treatment image upload pipeline)
# ──────────────────────────────────────────────────────────────────────
# Current policy: `null` while uploads remain authenticated, tenant-isolated,
# image-only, magic-byte validated, dimension-bounded, and server re-encoded.
# Switch to `clamav` before introducing public/file-generic uploads or when a
# regulatory requirement mandates malware scanning.
ANTIVIRUS_DRIVER=null
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=10
# Absolute platform ceiling; subscription plans can impose a lower limit.
MEDIA_MAX_UPLOAD_MB=20
# Recover quarantine objects left pending by a temporary queue outage. The
# worker performs bounded retries; no separate Railway cron is required.
MEDIA_PENDING_RECOVERY_ENABLED=true
MEDIA_PENDING_RECOVERY_MIN_AGE_SECONDS=300
MEDIA_PENDING_RECOVERY_INTERVAL_SECONDS=60
MEDIA_PENDING_RECOVERY_BATCH_SIZE=100

# ──────────────────────────────────────────────────────────────────────
# Mail — REQUIRED for email verification + password reset
# ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@identa.uz
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────────────────────────────
# PayX (subscription billing) — REQUIRED for the billing flow
# These three are the ONLY PayX vars the app reads (see config/services.php).
# ──────────────────────────────────────────────────────────────────────
# API host. Invoice creation POSTs to {PAYX_BASE_URL}/api/v1/invoice. Use the
# host shown in your PayX dashboard/docs.
PAYX_BASE_URL=https://backend.payx.uz
# Merchant Bearer token used to CREATE invoices (PayxService::createCheckout).
PAYX_API_TOKEN=
# The static Bearer token PayX attaches to every webhook. PayxService::verifyWebhook
# compares the callback's `Authorization: Bearer …` against THIS value — so it
# must equal the project/webhook token shown in the PayX cabinet, or every
# callback is rejected and paid orders stay stuck in "pending". Enforced
# non-empty in production via SECRETS_ADDITIONAL_REQUIRED below.
PAYX_PROJECT_TOKEN=
# Optional: floor for the dedicated PayX webhook log channel (config/logging.php).
# Defaults to info; set to 'warning' to quieten or 'debug' for more detail. Logs
# go to stderr (visible in the Railway log stream) regardless of LOG_LEVEL.
PAYX_LOG_LEVEL=info

# ──────────────────────────────────────────────────────────────────────
# Google OAuth (sign-in with Google) — must match the frontend's
# `NEXT_PUBLIC_GOOGLE_CLIENT_ID`. Leave empty to disable Google sign-in.
# ──────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ──────────────────────────────────────────────────────────────────────
# Error monitoring (Sentry)
# ──────────────────────────────────────────────────────────────────────
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_ENVIRONMENT="${APP_ENV}"

# ──────────────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# ──────────────────────────────────────────────────────────────────────
# Trusted proxies — set to `*` only behind a single trusted LB (Cloudflare,
# Railway, etc.) or list the actual proxy IPs. Required so Laravel reads
# X-Forwarded-* headers correctly (HTTPS detection, real client IP).
# ──────────────────────────────────────────────────────────────────────
TRUSTED_PROXIES=*

# ──────────────────────────────────────────────────────────────────────
# Authentication tunables
# ──────────────────────────────────────────────────────────────────────
AUTH_PASSWORD_TIMEOUT=10800
# Default 30 days in minutes — bump if you want longer "remember me".
AUTH_REMEMBER_DURATION=43200

# ──────────────────────────────────────────────────────────────────────
# Production secret enforcement (fail-fast at boot)
# Comma-separated env var names that MUST be non-empty in production. The
# secrets validator aborts boot if any is missing. PAYX_PROJECT_TOKEN doubles
# as the webhook auth secret (PayxService::verifyWebhook) — enforcing it stops
# a misconfigured deploy from silently rejecting every PayX callback.
# ──────────────────────────────────────────────────────────────────────
SECRETS_ADDITIONAL_REQUIRED=PAYX_PROJECT_TOKEN
