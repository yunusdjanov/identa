release: php artisan route:clear && php artisan migrate --force
web: PHP_CLI_SERVER_WORKERS=${PHP_CLI_SERVER_WORKERS:-8} php artisan serve --host=0.0.0.0 --port=${PORT:-8080} --no-reload
worker: php artisan queue:work ${QUEUE_CONNECTION:-redis} --sleep=1 --tries=3 --timeout=${QUEUE_WORKER_TIMEOUT:-330} --memory=${QUEUE_WORKER_MEMORY:-384} --queue=${QUEUE_NAMES:-media,cleanup,default}
