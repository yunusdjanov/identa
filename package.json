{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "dev:local": "powershell -ExecutionPolicy Bypass -File .\\scripts\\start-local.ps1",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --maxWorkers=1",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "test:watch": "vitest",
    "test:backend": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backend-artisan.ps1 test",
    "db:migrate": "powershell -ExecutionPolicy Bypass -File .\\scripts\\sync-backend-db.ps1",
    "check:secrets": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backend-artisan.ps1 security:check-secrets",
    "check:runtime-security": "powershell -ExecutionPolicy Bypass -File .\\scripts\\backend-artisan.ps1 security:check-runtime",
    "check:core-guardrails": "node scripts/check-core-guardrails.mjs",
    "check:openapi": "node scripts/validate-openapi.mjs",
    "audit:frontend": "node scripts/audit-frontend.mjs",
    "audit:backend": "node scripts/backend-composer-audit.mjs",
    "audit:deps": "npm run audit:frontend && npm run audit:backend",
    "check:migrations": "powershell -ExecutionPolicy Bypass -File .\\scripts\\check-backend-migrations.ps1",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-e2e-cleanup.ps1 && playwright test",
    "test:e2e:headed": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run-e2e-cleanup.ps1 && playwright test --headed",
    "test:e2e:prod": "playwright test --config playwright.prod.config.ts",
    "perf:seed": "php scripts/perf-seed.php",
    "perf:snapshot": "php scripts/perf-snapshot.php",
    "quality:frontend": "npm run lint && npm run build && npm test",
    "quality:all": "npm run quality:frontend && npm run test:backend && npm run db:migrate && npm run check:migrations && npm run test:e2e",
    "quality:security": "npm run audit:deps",
    "release:preflight": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release-preflight.ps1",
    "release:preflight:production": "powershell -ExecutionPolicy Bypass -File .\\scripts\\release-preflight.ps1 -Production"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.62.0",
    "@tanstack/react-query": "^5.101.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.18.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "konva": "^10.3.0",
    "lucide-react": "^0.564.0",
    "next": "^16.2.11",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-konva": "^19.2.5",
    "recharts": "^3.9.0",
    "sonner": "^2.0.7",
    "source-map": "^0.7.6",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
